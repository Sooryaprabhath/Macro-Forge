{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macro-forge",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
