{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "macro-forge-www-redirect",
  "main": "www-redirect-worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.macroforge.site",
      "custom_domain": true
    }
  ]
}
